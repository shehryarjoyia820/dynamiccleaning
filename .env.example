# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://dieseldynamix.com

# --- Supabase (leads database, admin login, editable content) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose or commit this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Admin login email, created at /admin/setup
ADMIN_EMAIL=
# One-time code that unlocks /admin/setup (any long random string)
ADMIN_SETUP_TOKEN=

# --- Email: SMTP (preferred). Used for lead alerts, confirmations, proposals and follow-ups. ---
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender for lead alerts and customer confirmations
EMAIL_FROM="Diesel Dynamix <service@dieseldynamix.com>"
# Sender (and reply-to) for proposals, follow-ups and newsletter mail
MARKETING_FROM="Diesel Dynamix <info@dieseldynamix.com>"
# Optional: separate SMTP login for the marketing sender (e.g. info@ with its own Gmail App Password).
# If empty, the main SMTP login is used and info@ must be a Gmail "Send mail as" address of that account.
MARKETING_SMTP_USER=
MARKETING_SMTP_PASS=
# Optional override for where proposal replies go (defaults to the MARKETING_FROM address)
EMAIL_REPLY_TO=
# Max marketing emails per 24 hours (protects your SMTP account from being blocked)
EMAIL_DAILY_LIMIT=400
# Signs unsubscribe links (any long random string)
UNSUBSCRIBE_SECRET=
# Protects the daily follow-up cron (any long random string; Vercel sends it automatically)
CRON_SECRET=

# --- Email fallback: Resend API (only used if SMTP_HOST is empty) ---
RESEND_API_KEY=
SERVICE_INBOX=service@dieseldynamix.com

# --- Spam protection: Cloudflare Turnstile (optional but recommended) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random string used when hashing visitor IPs for rate limiting
IP_HASH_SALT=

# --- Google AdSense (publisher ID from AdSense → Account → Account information) ---
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Google Analytics 4 (loads only after cookie consent) ---
NEXT_PUBLIC_GA_ID=

# --- Optional: SMS alert to the team on each new booking (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Phones that get lead alerts, comma separated, e.g. +18585550123,+19515550123
TEAM_ALERT_PHONE=
# Optional WhatsApp alerts through Twilio (an approved WhatsApp sender number)
TWILIO_WHATSAPP_FROM=
# Optional free WhatsApp alerts through CallMeBot: "+18585550123:APIKEY" (comma-separate several)
CALLMEBOT_WHATSAPP=
